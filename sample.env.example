# =============================================================================
#  Future with Shivank — AI Harness · Section 1
#  sample.env.example  →  copy this file, rename the copy to  .env
# =============================================================================
#
#  HOW TO USE
#  1. Make a copy of this file and name the copy exactly:  .env
#       Mac/Linux/PowerShell :  cp sample.env.example .env
#       Windows (cmd)        :  copy sample.env.example .env
#  2. Pick ONE provider below (Option A or Option B) and paste your key.
#  3. Save the file (Ctrl+S / Cmd+S).
#
#  RULES
#  - Never share your .env file or post it online. It holds your secret keys.
#  - No spaces around "=" and no quotes:   KEY=value   (not KEY = "value")
#  - A line that starts with # is a comment. Python ignores it.
#
#  (Groq speaks the same "language" as OpenAI, so no code change is needed.)
# =============================================================================

# -----------------------------------------------------------------------------
# LLM_PROVIDER=openai | groq | anthropic | gemini | ollama | none     (auto-detected from the keys if empty)
LLM_PROVIDER=

# -----------------------------------------------------------------------------
DEFAULT_LLM=
# Defaults: openai -> gpt-6-luna, anthropic -> claude-haiku-5-5, ollama -> llama3.2
# For any OpenAI-compatible server (Groq, OpenRouter, vLLM, LM Studio): set BASE_URL and API_KEY

# for local use
# For LOCAL MODEL (Ollama) (free, local):  LLM_PROVIDER=ollama and LLM_MODEL=llama3.2  (run `ollama pull llama3.2` first)
OLLAMA_LOCAL_BASE_URL=http://localhost:11434/v1
OLLAMA_LLM=llama3.1:8b #gemma3:270m # gemma4


#  OPTION A — OpenAI (default, paid)
OPENAI_BASE_URL=https://api.groq.com/openai/v1
#  Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_LLM=llama-3.1-8b-instant #llama-3.3-70b-versatile #gpt-6-luna # gpt-5.6-sol


#  OPTION B — Groq (free tier, no OpenAI key needed)
GROQ_OPENAI_BASE_URL=https://api.groq.com/openai/v1
# (Groq keys start with "gsk_")
GROQ_API_KEY=
#  Model names change over time — see https://console.groq.com/docs/models
GROQ_LLM=openai/gpt-oss-120b # openai/gpt-oss-20b

# -----------------------------------------------------------------------------
GOOGLE_API_KEY=
GEMINI_LLM=gemini-2.5-flash

# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_LLM=
# -----------------------------------------------------------------------------
LOCAL_TRANSFORMER_LLM=microsoft/Phi-3-mini-4k-instruct #meta-llama/Llama-3.1-8B-Instruct
# -----------------------------------------------------------------------------
# Only set this if your model accepts it (many reasoning models only allow the default)
LLM_TEMPERATURE=0
# -----------------------------------------------------------------------------
# SAP GEN AI CORE PROXY
# -----------------------------------------------------------------------------

# AICORE_AUTH_URL=https://sapit-core-playground-vole.authentication.eu10.hana.ondemand.com
# AICORE_CLIENT_ID=
# AICORE_CLIENT_SECRET=
# AICORE_RESOURCE_GROUP=default
# AICORE_BASE_URL=https://api.ai.prod.eu-central-1.aws.ml.hana.ondemand.com

# svcKey["url"]
AICORE_AUTH_URL=

# svcKey["clientid"]
AICORE_CLIENT_ID=

# svcKey["clientsecret"]
AICORE_CLIENT_SECRET=

AICORE_RESOURCE_GROUP=default

# svcKey["serviceurls"]["AI_API_URL"]
AICORE_BASE_URL=


# HANA_VECTOR_USER=DBADMIN
# HANA_VECTOR_PASS=
# HANA_HOST_VECTOR=uuid-hna1.prod-us10.hanacloud.ondemand.com

# -----------------------------------------------------------------------------
#  OPTIONAL — LangSmith tracing (see every LLM call at smith.langchain.com)
#  Works with OpenAI, Groq and Ollama. Remove the "#" to switch it on.
# -----------------------------------------------------------------------------
# smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_paste-your-langsmith-key-here
# LANGSMITH_PROJECT=section-01-langchain-foundations
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# -----------------------------------------------------------------------------
#  https://www.tavily.com/
TAVILY_API_KEY=
# -----------------------------------------------------------------------------
# https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
# -----------------------------------------------------------------------------
# AWS Free tier model > IAM > Users > bedrcok-cli-user > create access key
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=default
# -----------------------------------------------------------------------------
# Hugging Face
HF_TOKEN=
# -----------------------------------------------------------------------------
# NPS_SURVEY_PATH=demo_sample_data/nps_survey.csv     # or point at your own demo NPS survey CSV
